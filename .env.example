# Example environment variables for HR Policy KnowledgeMate
# Copy this file to `.env` and fill values before running locally.

# Database connection used by SQLAlchemy (Postgres + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/knowledgemate

# API URL used by the Streamlit UI to call the backend
API_URL=http://localhost:8000/chat

# Example placeholder for any API keys the project may need later
# OPENAI_API_KEY=your_openai_api_key_here